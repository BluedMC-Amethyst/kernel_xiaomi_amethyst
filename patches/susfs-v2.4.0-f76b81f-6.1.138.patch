+	if (uid >= 90000)
+		return true;
+
+	if (uid < SUSFS_UID_FILTER_MIN_UID ||
+		uid > SUSFS_UID_FILTER_MAX_UID)
+		return false;
+
+	rcu_read_lock();
+	bitmap = rcu_dereference(sus_path_uid_filter_bitmap);
